{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "family_roots": {
      "type": "object",
      "properties": {
        "roots": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^per_[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
          },
          "uniqueItems": true
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["roots", "rationale"],
      "additionalProperties": false
    },
    "reviewed_name_contexts": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "contexts": {
          "type": "object",
          "patternProperties": {
            "^cit_[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$": {
              "type": "object",
              "properties": {
                "region": {
                  "const": "US"
                },
                "basis": {
                  "type": "string",
                  "minLength": 1
                },
                "subject_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^per_[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
                  },
                  "uniqueItems": true
                }
              },
              "required": ["region", "basis"],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["version", "contexts"],
      "additionalProperties": false
    },
    "historical_name_rules": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "qualifications": {
          "type": "string",
          "minLength": 1
        },
        "archive_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "retrieved": {
          "type": "string",
          "minLength": 1
        },
        "minimum_count": {
          "type": "integer",
          "minimum": 0
        },
        "minimum_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "suppression_allowance_per_decade": {
          "type": "integer",
          "minimum": 0
        },
        "cohorts": {
          "type": "object",
          "patternProperties": {
            "^(1880|1890|1900|1910)$": {
              "type": "object",
              "patternProperties": {
                "^[a-z]+$": {
                  "type": "object",
                  "properties": {
                    "icon": {
                      "enum": ["male", "female"]
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "other_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "minimum_share": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": ["icon", "count", "other_count", "minimum_share"],
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "geography": {
          "type": "object",
          "properties": {
            "US": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "qualification": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["US", "qualification"],
          "additionalProperties": false
        },
        "historical_attestation": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "retrieved": {
              "type": "string",
              "minLength": 1
            },
            "periods": {
              "type": "object",
              "patternProperties": {
                "^(1500|1600|1700|1800)$": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "minimum_each_period": {
              "type": "integer",
              "minimum": 0
            },
            "minimum_total": {
              "type": "integer",
              "minimum": 0
            },
            "qualification": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "source",
            "description",
            "method",
            "sha256",
            "retrieved",
            "periods",
            "minimum_each_period",
            "minimum_total",
            "qualification"
          ],
          "additionalProperties": false
        },
        "stable_historical_names": {
          "type": "object",
          "patternProperties": {
            "^[a-z]+$": {
              "type": "object",
              "properties": {
                "icon": {
                  "enum": ["male", "female"]
                },
                "minimum_share": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "attestations_by_period": {
                  "type": "object",
                  "patternProperties": {
                    "^(1500|1600|1700|1800)$": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": ["icon", "minimum_share", "attestations_by_period"],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "source",
        "qualifications",
        "archive_sha256",
        "retrieved",
        "minimum_count",
        "minimum_share",
        "suppression_allowance_per_decade",
        "cohorts",
        "geography",
        "historical_attestation",
        "stable_historical_names"
      ],
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1,
          "type": "integer"
        },
        "build_year": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "name_policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "family_roots_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "historical_name_rules_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewed_name_contexts_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "schema_version",
        "build_year",
        "name_policy_sha256",
        "family_roots_sha256",
        "historical_name_rules_sha256",
        "reviewed_name_contexts_sha256"
      ],
      "additionalProperties": false
    }
  }
}
